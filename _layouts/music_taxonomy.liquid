---
layout: default
---

<div class="post">
  <div class="header-bar">
    <h1>
      {% if page.taxonomy == "tag" %}# {{ page.term }}{% else %}<i class="fa-solid fa-tag fa-sm"></i> {{ page.term }}{% endif %}
    </h1>
    <h2>Music posts</h2>
  </div>

  {% assign items = site.music %}
  {% if page.taxonomy == "tag" %}
    {% assign filtered = items | where_exp: "p", "p.tags contains page.term" %}
  {% else %}
    {% assign filtered = items | where_exp: "p", "p.categories contains page.term" %}
  {% endif %}

  <ul class="post-list">
    {% for post in filtered | sort: "date" | reverse %}
      <li>
        <h3><a class="post-title" href="{{ post.url | relative_url }}">{{ post.title }}</a></h3>
        <p>{{ post.description }}</p>
        <p class="post-meta">{{ post.date | date: '%B %d, %Y' }}</p>
      </li>
    {% endfor %}
  </ul>
</div>
